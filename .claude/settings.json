{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/SessionStart.sh",
            "outHandle": "print"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "echo '[Compound Engineering] If this commit fixed a non-trivial bug or implemented a feature, run /project:compound to document learnings. Solutions index: docs/solutions/INDEX.md'",
            "outHandle": "print"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
