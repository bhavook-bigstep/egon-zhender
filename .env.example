# Copy to .env (git-ignored) and adjust. app/main.py auto-loads .env; real shell env wins.

# Which config the app runs. Default (unset) = config/ws1.yaml (local synthetic sample).
# Point at the Databricks Unity Catalog volume source:
WS1_API_CONFIG=config/ws1.databricks.yaml

# Databricks CLI profile for auth (see: databricks auth profiles). Leave the config's
# profile: null and set it here; blank falls back to the DEFAULT OAuth profile.
DATABRICKS_CONFIG_PROFILE=you@example.com

# Registry / job queue DB (default poc/registry.db).
# WS1_REGISTRY_DB=poc/registry.db

# Reveal the matched value in the review UI. OFF by default (production-safe): it puts
# sensitive content on screen. Enable ONLY on local loopback with synthetic/approved data.
# WS1_SHOW_MATCHED_CONTENT=1

# DEMO LLM step (config/ws1.databricks.yaml, synthetic data only). Google AI Studio key.
# This is external inference egress — never use it against real data.
GEMINI_API_KEY=gemini-api-key

